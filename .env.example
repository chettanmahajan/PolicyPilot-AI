# Copy to .env and fill in real values. Never commit .env.

# --- Required -------------------------------------------------------------

# Gemini API key - create one at https://aistudio.google.com/u/0/api-keys
GEMINI_API_KEY=your-key

# Random secret used to sign JWTs. Must be at least 32 characters; the app
# refuses to start with a shorter one. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-random-secret

# --- Optional -------------------------------------------------------------
# Defaults live in src/config.py. Uncomment a line only to override it.

# JWT_EXPIRE_MINUTES=60
# DATABASE_URL=sqlite:///./policypilot.db
# GEMINI_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# API_BASE_URL=http://127.0.0.1:8000
